# The production domain, once one is actually confirmed/deployed.
# Used for canonical URLs, OpenGraph/Twitter metadata, sitemap.xml and
# structured data. Falls back to http://localhost:3000 when unset — never
# hard-code a guessed production domain in source.
NEXT_PUBLIC_SITE_URL=https://your-confirmed-domain.example

# CodePhantom Backend base URL (server-side only, e.g. https://api.example.com).
# Used at build/revalidation time to read PUBLIC, moderated data such as
# approved testimonials. Leave unset to disable; the site never depends on it.
CODEPHANTOM_API_URL=

# WhatsApp community invite link (https://chat.whatsapp.com/<code>). Only a
# genuine invite link is accepted; unset/invalid hides the community CTA.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
