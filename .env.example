# The production domain, once one is actually confirmed/deployed.
# Used for canonical URLs, OpenGraph/Twitter metadata, sitemap.xml and
# structured data. Falls back to http://localhost:3000 when unset — never
# hard-code a guessed production domain in source.
NEXT_PUBLIC_SITE_URL=https://your-confirmed-domain.example

# CodePhantom Backend base URL (server-side only, e.g. https://api.example.com).
# Used at build/revalidation time to read PUBLIC, moderated data such as
# approved testimonials. Leave unset to disable; the site never depends on it.
CODEPHANTOM_API_URL=

# CodePhantom Traders WhatsApp group invite (the existing group, formerly
# TAT Market Direction). Only a genuine https://chat.whatsapp.com/<code>
# link is accepted; WhatsApp's share parameters (?s=..&p=..) are allowed and
# stripped. Unset/invalid hides the "Join CodePhantom Traders" CTA.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/CGUao6NoNZfB80xoCChoq4?s=cl&p=a&mlu=4&ilr=4

# Android release shown on /download. Leave ALL unset until a real signed
# release exists (nothing is offered unless every field is valid).
# URL: https GitHub release asset (or this site's own domain).
NEXT_PUBLIC_ANDROID_RELEASE_VERSION=
NEXT_PUBLIC_ANDROID_RELEASE_URL=
NEXT_PUBLIC_ANDROID_RELEASE_SHA256=
NEXT_PUBLIC_ANDROID_RELEASE_DATE=
NEXT_PUBLIC_ANDROID_RELEASE_CHANNEL=
